{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Current shared-car editable projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "databaseId",
    "recoveryId",
    "id",
    "revision",
    "archived",
    "fields",
    "unparsed",
    "truncated"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "databaseId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,100}$"
    },
    "recoveryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,100}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "archived": {
      "type": "boolean"
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "maker",
        "marque",
        "model",
        "reference",
        "scale",
        "number",
        "livery",
        "raceClass",
        "availability",
        "motor",
        "motorLayout",
        "rearTyres",
        "frontTyres",
        "guide",
        "braids",
        "chassis",
        "body",
        "pod",
        "pinion",
        "gear",
        "weight",
        "rearDiameter",
        "frontDiameter",
        "ratedRpm",
        "ratedVoltage"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 200,
          "minLength": 0
        },
        "maker": {
          "type": "string",
          "maxLength": 1000,
          "minLength": 0
        },
        "marque": {
          "type": "string",
          "maxLength": 1000,
          "minLength": 0
        },
        "model": {
          "type": "string",
          "maxLength": 1000,
          "minLength": 0
        },
        "reference": {
          "type": "string",
          "maxLength": 1000,
          "minLength": 0
        },
        "scale": {
          "type": "string",
          "maxLength": 100,
          "minLength": 0
        },
        "number": {
          "type": "string",
          "maxLength": 100,
          "minLength": 0
        },
        "livery": {
          "type": "string",
          "maxLength": 1000,
          "minLength": 0
        },
        "raceClass": {
          "type": "string",
          "maxLength": 1000,
          "minLength": 0
        },
        "availability": {
          "type": "string",
          "maxLength": 200,
          "minLength": 0
        },
        "motor": {
          "type": "string",
          "maxLength": 1000,
          "minLength": 0
        },
        "motorLayout": {
          "type": "string",
          "maxLength": 100,
          "minLength": 0
        },
        "rearTyres": {
          "type": "string",
          "maxLength": 1000,
          "minLength": 0
        },
        "frontTyres": {
          "type": "string",
          "maxLength": 1000,
          "minLength": 0
        },
        "guide": {
          "type": "string",
          "maxLength": 1000,
          "minLength": 0
        },
        "braids": {
          "type": "string",
          "maxLength": 1000,
          "minLength": 0
        },
        "chassis": {
          "type": "string",
          "maxLength": 1000,
          "minLength": 0
        },
        "body": {
          "type": "string",
          "maxLength": 1000,
          "minLength": 0
        },
        "pod": {
          "type": "string",
          "maxLength": 1000,
          "minLength": 0
        },
        "pinion": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1000
        },
        "gear": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1000
        },
        "weight": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100000
        },
        "rearDiameter": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0.001,
          "maximum": 1000
        },
        "frontDiameter": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0.001,
          "maximum": 1000
        },
        "ratedRpm": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000
        },
        "ratedVoltage": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0.001,
          "maximum": 1000
        }
      }
    },
    "unparsed": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "truncated": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "name",
          "maker",
          "marque",
          "model",
          "reference",
          "scale",
          "number",
          "livery",
          "raceClass",
          "availability",
          "motor",
          "motorLayout",
          "rearTyres",
          "frontTyres",
          "guide",
          "braids",
          "chassis",
          "body",
          "pod",
          "pinion",
          "gear",
          "weight",
          "rearDiameter",
          "frontDiameter",
          "ratedRpm",
          "ratedVoltage"
        ]
      }
    }
  }
}
