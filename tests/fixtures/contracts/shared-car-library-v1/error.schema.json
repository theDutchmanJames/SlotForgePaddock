{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "code",
    "error"
  ],
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "current": {
          "$ref": "receipt.schema.json#/$defs/car"
        },
        "recoveryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "successor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "date"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "name": {
              "type": "string",
              "maxLength": 200
            },
            "date": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  }
}
