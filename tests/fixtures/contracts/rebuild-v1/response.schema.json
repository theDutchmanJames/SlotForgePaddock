{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paddock rebuild lifecycle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "databaseId", "carId", "archived", "predecessor", "successor"],
  "properties": {
    "version": {"const": 1},
    "databaseId": {"type": "string", "minLength": 1, "maxLength": 100},
    "carId": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,100}$"},
    "archived": {"type": "boolean"},
    "predecessor": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/edge"}]},
    "successor": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/edge"}]}
  },
  "$defs": {
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "date"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,100}$"},
        "name": {"type": "string", "maxLength": 200},
        "date": {"type": "string", "format": "date-time"}
      }
    }
  }
}
