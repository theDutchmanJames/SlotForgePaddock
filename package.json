{
  "name": "slotforge-database",
  "version": "1.7.0",
  "description": "Slot-car collections, parts and setup history",
  "author": "theDutchmanJames",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check-syntax.cjs",
    "dist": "electron-builder --win",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "build:splash": "electron scripts/build-startup-splash.cjs",
    "build:icons": "node scripts/build-icons.cjs",
    "build:diagram": "node scripts/build-diagram.cjs",
    "benchmark:database": "node scripts/benchmark-database.cjs",
    "build:app-icon": "electron scripts/build-app-icon.cjs",
    "benchmark:sqlite": "node scripts/benchmark-sqlite.cjs",
    "qualify:storage": "node scripts/qualify-storage.cjs",
    "qualify:large": "node scripts/qualify-large-active.cjs",
    "qualify:local-library": "node scripts/qualify-local-library.cjs",
    "qualify:local-library:large": "node scripts/qualify-local-library.cjs --large",
    "qualify:shared-launch": "node scripts/qualify-shared-launch.cjs",
    "test:history:activation": "node scripts/qualify-history-gates.cjs",
    "dist:portable": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "prettier": "3.3.3"
  },
  "build": {
    "afterPack": "scripts/portable-splash.cjs",
    "appId": "nl.slotforge.database",
    "productName": "SlotForge Paddock",
    "directories": {
      "output": "dist/v${version}"
    },
    "files": [
      "src/**/*",
      "packages/shared-library/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "splashImage": "assets/startup-splash.bmp",
      "artifactName": "SlotForgePaddock-${version}-Portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icon-mac.svg",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "artifactName": "SlotForgePaddock-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "maintainer": "theDutchmanJames <thedutchmanjames@gmail.com>",
      "synopsis": "Slotcar collection and workshop",
      "artifactName": "SlotForgePaddock-${version}-linux-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "SlotForge-Paddock-LICENSE.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      },
      {
        "from": "src/vendor/QRCode/LICENSE-qrcode-terminal.txt",
        "to": "licenses/QRCode-LICENSE.txt"
      },
      {
        "from": "src/vendor/QRCode/LICENSE-MIT.txt",
        "to": "licenses/QRCode-MIT-LICENSE.txt"
      }
    ],
    "protocols": [
      {
        "name": "SlotForge Paddock car",
        "schemes": [
          "slotforge-paddock"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "packElevateHelper": false,
      "include": "build/installer.nsh",
      "artifactName": "SlotForgePaddock-${version}-Setup.${ext}"
    }
  },
  "homepage": "https://github.com/theDutchmanJames/SlotForgePaddock",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theDutchmanJames/SlotForgePaddock.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "htmlparser2": "10.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
